# Front Door — copy to `.env`, fill in, then `python front_door/run.py`. See DEPLOY.md.

# --- Board reads (required) ---
GITHUB_READ_TOKEN=
FRONT_DOOR_REPOS=NFS-247/StockTrader,NFS-247/Canary

# --- Local dev write identity (operator). Skip in prod once OAuth is set. ---
FRONT_DOOR_DEV_TOKEN=

# --- Production: GitHub OAuth (set these instead of the dev token) ---
# Register an OAuth app with callback <FRONT_DOOR_PUBLIC_URL>/auth/callback.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# FRONT_DOOR_PUBLIC_URL=https://app.example.com
